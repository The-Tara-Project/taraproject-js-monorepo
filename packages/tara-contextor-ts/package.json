{
    "name": "@jose_pereiro/tara-contextor-ts",
    "version": "0.0.1",
    "description": "Tara Contextor TypeScript implementation",
    "private": true,
    "type": "commonjs",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs",
        "build": "tsc --emitDeclarationOnly && node esbuild.config.mjs production",
        "typecheck": "tsc -noEmit",
        "test": "vitest",
        "test-watch": "vitest",
        "test-run": "vitest run"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@jose_pereiro/taralib-js": "^0.0.1"
    },
    "devDependencies": {
        "@types/node": "^24.3.0",
        "@vitest/coverage-v8": "^2.1.3",
        "builtin-modules": "^5.0.0",
        "esbuild": "^0.25.9",
        "typescript": "^5.9.2",
        "vitest": "^2.1.3"
    }
}
