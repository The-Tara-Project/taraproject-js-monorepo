{
    "name": "@jose_pereiro/taraproject-cli",
    "version": "0.0.1",
    "description": "Command-line interface for Tara tape management",
    "private": true,
    "type": "commonjs",
    "main": "dist/cli.js",
    "bin": {
        "tara": "dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs",
        "build": "tsc --emitDeclarationOnly && node esbuild.config.mjs production",
        "typecheck": "tsc -noEmit",
        "test": "vitest run"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@jose_pereiro/taralib-js": "file:../taralib-js",
        "commander": "^12.1.0",
        "chalk": "^4.1.2",
        "cli-table3": "^0.6.5",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@types/node": "^24.3.0",
        "@vitest/coverage-v8": "^2.1.3",
        "builtin-modules": "^5.0.0",
        "esbuild": "^0.25.9",
        "typescript": "^5.9.2",
        "vitest": "^2.1.3"
    }
}
