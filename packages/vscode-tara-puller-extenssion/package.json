{
    "name": "tara-puller-vscode-extenssion",
    "displayName": "Tara Puller",
    "description": "VS Code extension that periodically asks what you're doing and records to a Tara tape",
    "version": "0.0.1",
    "private": true,
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "taraPuller.askNow",
                "title": "Tara Puller: Ask Now"
            },
            {
                "command": "taraPuller.showStatus",
                "title": "Tara Puller: Show Status"
            },
            {
                "command": "taraPuller.setFrequency",
                "title": "Tara Puller: Set Frequency"
            },
            {
                "command": "taraPuller.toggleEnabled",
                "title": "Tara Puller: Toggle Enabled/Disabled"
            },
            {
                "command": "taraPuller.toggleTestMode",
                "title": "Tara Puller: Toggle Test Mode"
            }
        ],
        "configuration": {
            "title": "Tara Puller",
            "properties": {
                "taraPuller.minInterval": {
                    "type": "number",
                    "default": 60,
                    "minimum": 10,
                    "description": "Minimum interval between prompts in seconds"
                },
                "taraPuller.checkInterval": {
                    "type": "number",
                    "default": 10,
                    "minimum": 1,
                    "description": "How often to check if conditions are met (in seconds)"
                },
                "taraPuller.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable or disable Tara Puller automatic prompts"
                },
                "taraPuller.testMode": {
                    "type": "boolean",
                    "default": false,
                    "description": "When enabled, uses ~/.taraproject/dev/tara-puller-test-stack/ for testing"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build:prod",
        "build": "node esbuild.config.mjs",
        "build:prod": "node esbuild.config.mjs production",
        "watch": "tsc -watch -p ./",
        "typecheck": "tsc -noEmit",
        "test": "echo \"No tests yet\"",
        "dev-install": "node dev-install.js"
    },
    "devDependencies": {
        "@jose_pereiro/taralib-js": "file:../taralib-js",
        "@jose_pereiro/tara-contextor-ts": "file:../tara-contextor-ts",
        "@types/vscode": "^1.85.0",
        "@types/node": "^24.3.0",
        "builtin-modules": "^5.0.0",
        "esbuild": "^0.25.9",
        "typescript": "^5.9.2"
    }
}
