{
    "name": "taraproject-vscode-extenssion",
    "displayName": "Tara Reader",
    "description": "Browse and view Tara tapes (read-only)",
    "version": "0.0.1",
    "private": true,
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "tara-reader",
                    "title": "Tara Tapes",
                    "icon": "$(database)"
                }
            ]
        },
        "views": {
            "tara-reader": [
                {
                    "id": "taraReader.tapesView",
                    "name": "Tapes"
                }
            ]
        },
        "commands": [
            {
                "command": "taraReader.refreshTapes",
                "title": "Refresh Tapes",
                "icon": "$(refresh)"
            },
            {
                "command": "taraReader.openTape",
                "title": "Open Tape (Read-Only)"
            },
            {
                "command": "taraReader.copyTapePath",
                "title": "Copy Tape Path"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "taraReader.refreshTapes",
                    "when": "view == taraReader.tapesView",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "taraReader.openTape",
                    "when": "viewItem == tape"
                },
                {
                    "command": "taraReader.copyTapePath",
                    "when": "viewItem == tape"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build:prod",
        "build": "node esbuild.config.mjs",
        "build:prod": "node esbuild.config.mjs production",
        "watch": "tsc -watch -p ./",
        "typecheck": "tsc -noEmit",
        "test": "echo \"No tests yet\"",
        "dev-install": "node dev-install.js"
    },
    "devDependencies": {
        "@jose_pereiro/taralib-js": "file:../taralib-js",
        "@types/vscode": "^1.85.0",
        "@types/node": "^24.3.0",
        "builtin-modules": "^5.0.0",
        "esbuild": "^0.25.9",
        "typescript": "^5.9.2"
    }
}
