{
    "name": "vscode-tara-puller-001-extenssion",
    "displayName": "Tara Puller",
    "description": "VS Code extension for Tara project",
    "version": "0.0.1",
    "private": true,
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "taraPuller.helloWorld",
                "title": "Tara Puller: Hello World"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "typecheck": "tsc -noEmit",
        "test": "echo \"No tests yet\""
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@types/node": "^24.3.0",
        "typescript": "^5.9.2"
    }
}
